{
  "realm": "company-brain",
  "enabled": true,
  "clientScopes": [
    {
      "name": "mcp",
      "description": "Company Brain MCP access",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Access the Company Brain knowledge base"
      },
      "protocolMappers": [
        {
          "name": "mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "$(env:MCP_RESOURCE)",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "basic",
    "mcp"
  ],
  "components": {
    "org.keycloak.services.clientregistration.policy.ClientRegistrationPolicy": [
      {
        "name": "Trusted Hosts",
        "providerId": "trusted-hosts",
        "subType": "anonymous",
        "config": {
          "trusted-hosts": ["localhost", "127.0.0.1"],
          "host-sending-registration-request-must-match": ["false"],
          "client-uris-must-match": ["true"]
        }
      },
      {
        "name": "Consent Required",
        "providerId": "consent-required",
        "subType": "anonymous",
        "config": {}
      },
      {
        "name": "Allowed Client Scopes",
        "providerId": "allowed-client-templates",
        "subType": "anonymous",
        "config": {
          "allow-default-scopes": ["true"]
        }
      },
      {
        "name": "Max Clients Limit",
        "providerId": "max-clients",
        "subType": "anonymous",
        "config": {
          "max-clients": ["20"]
        }
      }
    ]
  },
  "users": [
    {
      "username": "dev",
      "email": "dev@onfabric.io",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "$(env:KEYCLOAK_DEV_USER_PASSWORD)"
        }
      ]
    }
  ]
}
