{$NANGO_HOSTNAME} {
	reverse_proxy nango-server:3003 {
		# Retry dial failures to ride out the container recreate gap on deploy.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

{$NANGO_CONNECT_HOSTNAME} {
	reverse_proxy nango-server:3009 {
		# Retry dial failures to ride out the container recreate gap on deploy.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

{$BRAIN_HOSTNAME} {
	# The brain owns the whole origin: the dashboard SPA at the root, the REST API
	# under /api, the MCP transport at /mcp, and the OAuth discovery documents at
	# /.well-known. Unknown paths resolve to the SPA shell, so forward everything.
	reverse_proxy brain:3010 {
		# Retry dial failures to ride out the container recreate gap on deploy.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

