{$NANGO_HOSTNAME} {
	reverse_proxy nango-server:3003 {
		# Retry dial failures to ride out the container recreate gap on deploy.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

{$NANGO_CONNECT_HOSTNAME} {
	reverse_proxy nango-server:3009 {
		# Retry dial failures to ride out the container recreate gap on deploy.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

{$BRAIN_HOSTNAME} {
	@public path /api/auth/* /sign-in /consent /.well-known/* /dashboard /dashboard/* /data-sources /data-sources/* /health /knowledge /knowledge/* /knowledge-types /knowledge-types/* /mcp /people /people/* /records /records/* /sessions /openapi /openapi/*
	handle @public {
		reverse_proxy brain:3010 {
			# Retry dial failures to ride out the container recreate gap on deploy.
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
	handle {
		respond 404
	}
}

