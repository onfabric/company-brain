{$NANGO_HOSTNAME} {
	reverse_proxy nango-server:3003 {
		# Retry dial failures to ride out the container recreate gap on deploy.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

{$NANGO_CONNECT_HOSTNAME} {
	reverse_proxy nango-server:3009 {
		# Retry dial failures to ride out the container recreate gap on deploy.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

{$BRAIN_HOSTNAME} {
	# Forward everything to the brain EXCEPT /internal/* (e.g. the Nango batch-save
	# webhook), which must stay reachable only on the compose network.
	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}
	handle {
		reverse_proxy brain:3010 {
			# Retry dial failures to ride out the container recreate gap on deploy.
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
}

{$DOZZLE_HOSTNAME} {
	reverse_proxy dozzle:8080 {
		# Retry dial failures to ride out the container recreate gap on deploy.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}
