# Copy to .env and fill in. Never commit .env.
#
# Anything truly opinionated (internal service URLs, ports, schema names,
# logging on/off, etc.) lives in docker-compose.yml, not here.

# --- Required secrets ---

# Optional (patched in our nango fork): leave empty to disable encryption and
# store credentials/records as plaintext. To enable, set a 32-byte base64 key:
# openssl rand -base64 32
NANGO_ENCRYPTION_KEY=

# UUIDv4 external clients send as the `Api-Key` header to reach the brain's
# public routes. Internal callers (Nango → /webhooks/*) and /health are exempt.
# Terraform generates this in prod; locally generate with: uuidgen
BRAIN_API_KEY=

# --- Database ---
# Host (`postgres-db`) and port (5432) are fixed by the compose topology and
# hardcoded in docker-compose.yml.
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=nango
NANGO_DB_NAME=company_brain
NANGO_DB_SCHEMA=nango
# Schema Nango stores synced records in (its own default). Set explicitly so the
# brain grant in db/prepare/01-brain.sh targets the same schema.
NANGO_RECORDS_DATABASE_SCHEMA=nango_records

# Least-privilege role for the brain service: owns the `brain` schema and can
# read + FK-reference `nango_records` (SELECT + REFERENCES; never the `nango`
# app/credentials schema). Provisioned by the db-prepare service (db/prepare/01-brain.sh).
BRAIN_DB_USER=brain
BRAIN_DB_PASSWORD=brain

# --- Host-bound ports ---
# Host ports the services bind to. Internal container ports are fixed.
# Public (reachable from outside the EC2 box):
NANGO_SERVER_PORT=3003  # update NANGO_SERVER_URL when you update this
NANGO_CONNECT_UI_PORT=3009  # update NANGO_PUBLIC_CONNECT_URL when you update this
# --- Public-facing URLs ---
# How browsers / external services reach the deployment.
NANGO_SERVER_URL=http://localhost:3003  # update NANGO_SERVER_PORT when you update this
NANGO_PUBLIC_SERVER_URL=http://localhost:3000
# Base URL of the Connect UI; embedded in the connect links Nango hands out, so
# it must be reachable by the end user (not localhost when the server is remote).
NANGO_PUBLIC_CONNECT_URL=http://localhost:3009  # update NANGO_CONNECT_UI_PORT when you update this

# Loopback only (127.0.0.1, SSH-tunnel from your laptop to access):
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
DOZZLE_PORT=8080
# Brain (Data Transformation Service). Internal-only; reachable in-stack at
# http://brain:3010, this host binding is just for local debugging.
BRAIN_SERVER_PORT=3010
# Brain record dashboard is served by the brain service at /dashboard. It asks
# for the API key in the browser and keeps it only in tab memory.

# --- MCP OAuth (Google OAuth proxy via mcp-use) ---
# The MCP server (mcp-use, mounted headless into Elysia) authenticates clients
# directly against Google with the OAuth proxy pattern: no self-hosted identity
# provider, container, or database. The brain is Google's single pre-registered
# OAuth client and mediates the flow so public MCP clients connect without
# Google supporting Dynamic Client Registration. Create the OAuth client ONCE in
# the Google Cloud console (type "Web application") and register the MCP
# clients' redirect URIs on it, e.g. https://claude.ai/api/mcp/auth_callback.
# Fake local values below.
GOOGLE_CLIENT_ID=000000000000-fakeexamplelocalclientid.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-fake-local-client-secret
# The public origin the brain serves its OAuth metadata, /authorize, /token, and
# /register on (the OAuth issuer advertised to MCP clients).
BRAIN_PUBLIC_URL=http://localhost:3010
# Google Workspace domain MCP access is restricted to. Defaults to onfabric.io.
GOOGLE_WORKSPACE_DOMAIN=onfabric.io

# --- Feature flags ---

FLAG_AUTH_ENABLED=false
# Dashboard basic-auth credentials. Only used as the dashboard login when
# FLAG_AUTH_ENABLED=false (local). With auth enabled (deployment) the dashboard
# uses session login and these are ignored, so they aren't set there.
NANGO_DASHBOARD_USERNAME=
NANGO_DASHBOARD_PASSWORD=
BRAIN_HOSTNAME=

# --- Logging ---

LOG_LEVEL=info
