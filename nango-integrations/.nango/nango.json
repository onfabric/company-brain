                },
                "commits": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      },
                      "authored_at": {
                        "type": "string"
                      },
                      "author": {
                        "type": "object",
                        "properties": {
                          "username": {
                            "type": "string"
