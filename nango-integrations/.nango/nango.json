[
  {
    "providerConfigKey": "slack",
    "actions": [],
    "syncs": [
      {
        "type": "sync",
        "description": "Sync self-contained Slack thread records with channel context, message authors, mentions, files, links, and reactions",
        "auto_start": true,
        "endpoints": [
          {
            "method": "POST",
            "path": "/syncs/threads",
            "group": "Threads"
          }
        ],
        "input": "SyncMetadata_slack_threads",
        "name": "threads",
        "output": [
          "SlackThread"
        ],
        "runs": "every hour",
        "scopes": [],
        "sync_type": "full",
        "track_deletes": false,
        "usedModels": [
          "SlackThread",
          "SyncMetadata_slack_threads"
        ],
        "version": "2.0.0",
        "webhookSubscriptions": [],
        "json_schema": {
          "definitions": {
            "SlackThread": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "channel": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "string"
                },
                "messages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "created_at": {
                        "type": "string"
                      },
                      "updated_at": {
                        "type": "string"
                      },
                      "author": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name"
                        ],
                        "additionalProperties": false
                      },
                      "text": {
                        "type": "string"
                      },
                      "mentions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "email": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "name"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "reactions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "actors": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "name": {
                                    "type": "string"
                                  },
                                  "email": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "name"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "name",
                            "actors"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "files": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "author": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "email": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "name"
                              ],
                              "additionalProperties": false
                            },
                            "created_at": {
                              "type": "string"
                            },
                            "permalink": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "author",
                            "created_at",
                            "permalink"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "links": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "url"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "created_at",
                      "author",
                      "text"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "body",
                "channel",
                "created_at",
                "updated_at",
                "messages"
              ],
              "additionalProperties": false
            },
            "SyncMetadata_slack_threads": {
              "type": "object",
              "properties": {
                "joinPublicChannels": {
                  "description": "Whether to auto-join public channels before reading their history",
                  "type": "boolean"
                },
                "includeArchived": {
                  "description": "Whether to include archived conversations",
                  "type": "boolean"
                },
                "channelTypes": {
                  "description": "Comma-separated Slack conversation types to sync",
                  "type": "string"
                },
                "resyncWindowDays": {
                  "description": "How far back to re-read existing channels to catch edits, replies, and reactions",
                  "type": "number"
                },
                "maxChannelsPerRun": {
                  "description": "Optional cap for channel processing in one execution",
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "features": [
          "checkpoints"
        ]
      }
    ],
    "onEventScripts": {
      "post-connection-creation": [],
      "pre-connection-deletion": [],
      "validate-connection": []
    }
  }
]