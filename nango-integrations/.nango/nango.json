                      "username"
                    ],
                    "additionalProperties": false
                  }
                },
                "requested_reviewers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "username": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "username"
                    ],
                    "additionalProperties": false
                  }
                },
                "assignees": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "username": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "username"
                    ],
                    "additionalProperties": false
                  }
                },
                "labels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "milestone": {
                  "type": "string"
                },
                "source_branch": {
                  "type": "string"
                },
                "target_branch": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "string"
                },
                "closed_at": {
                  "type": "string"
                },
                "merged_at": {
                  "type": "string"
                },
                "additions": {
                  "type": "number"
                },
                "deletions": {
