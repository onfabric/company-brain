{
  "name": "nango-integrations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:backend-client": "bun run _scripts/build-backend-client.ts",
    "compile": "bun run build:backend-client && nango compile",
    "deploy": "bun run build:backend-client && nango deploy",
    "dev": "bun run build:backend-client && nango dev",
    "dryrun": "bun run build:backend-client && nango dryrun",
    "bootstrap:integrations": "bun run _scripts/bootstrap-integrations.ts",
    "bootstrap:connections": "bun run _scripts/bootstrap-connections.ts",
    "check:connections": "bun run _scripts/check-connections.ts",
    "test": "bun run build:backend-client && bun test",
    "check:types": "bun run build:backend-client && bun run --bun tsc"
  },
  "devDependencies": {
    "@company-brain/backend": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "elysia": "^1.4.28",
    "nango": "0.70.5",
    "rolldown": "^1.0.3",
    "rolldown-plugin-dts": "^0.25.2",
    "zod": "4.3.6"
  }
}
