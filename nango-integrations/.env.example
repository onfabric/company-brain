# Authenticates the CLI.
# Get keys from the Nango dashboard's Environment Settings.
NANGO_SECRET_KEY_DEV=
NANGO_SECRET_KEY_PROD=

# Nango instance URL. Package scripts default this to the local compose server
# when unset; keep it here to make the target explicit.
NANGO_HOSTPORT=http://localhost:3003

# OAuth credentials for integrations bootstrapped by CI/CD or local scripts.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SCOPES=channels:read,channels:history,channels:join,groups:read,groups:history,im:read,im:history,mpim:read,mpim:history,users:read,users:read.email

GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=
GH_OAUTH_SCOPES=public_repo,read:org,read:user,repo,user:email,user

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

AGENT_SYNC_WEBHOOK_SECRET=

# CLI behavior.
NANGO_CLI_UPGRADE_MODE=ignore
# NANGO_DEPLOY_AUTO_CONFIRM=false
NANGO_CLI_DEPENDENCY_UPDATE=false
