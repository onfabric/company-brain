# Authenticates the CLI.
# Get keys from the Nango dashboard's Environment Settings.
NANGO_SECRET_KEY_DEV=
NANGO_SECRET_KEY_PROD=

# Nango instance URL. Package scripts default this to the local compose server
# when unset; keep it here to make the target explicit.
NANGO_HOSTPORT=http://localhost:3003

# CLI behavior.
NANGO_CLI_UPGRADE_MODE=ignore
# NANGO_DEPLOY_AUTO_CONFIRM=false
NANGO_CLI_DEPENDENCY_UPDATE=false
