# Postgres connection. The service uses the same instance as Nango and connects
# as its own least-privilege `brain` role (see db/prepare/01-brain.sh): it owns the
# `brain` schema and can read + FK-reference `nango_records`. In the compose
# stack the host is the `postgres-db` service.
DATABASE_URL=postgresql://brain:brain@localhost:5432/company_brain

# Port the Elysia HTTP server listens on. Defaults to 3010.
PORT=3010

# --- MCP OAuth (better-auth) ---
# The brain is its own OAuth 2.1 authorization server for /mcp. Public origin it
# is reachable at — the issuer, JWKS host, and base for every discovery document.
BRAIN_PUBLIC_URL=http://localhost:3010
# better-auth signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-better-auth-secret-change-me-0000
# Google OAuth client — a one-time manual creation in the Google Cloud console
# (OAuth client ID, "Web application"). Authorized redirect URI:
# ${BRAIN_PUBLIC_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=local-fake-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=local-fake-google-client-secret
