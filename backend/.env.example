# Postgres connection. The service uses the same instance as Nango and connects
# as its own least-privilege `brain` role (see db/prepare/01-brain.sh): it owns the
# `brain` schema and can read + FK-reference `nango_records`. In the compose
# stack the host is the `postgres-db` service.
DATABASE_URL=postgresql://brain:brain@localhost:5432/company_brain

# Port the Elysia HTTP server listens on. Defaults to 3010.
PORT=3010

# --- MCP OAuth (Google OAuth proxy via mcp-use) ---
# The MCP server (mcp-use) authenticates clients against Google with the OAuth
# proxy pattern: the brain is Google's single pre-registered OAuth client and
# mediates the flow so public MCP clients connect without Google supporting
# Dynamic Client Registration. mcp-use serves /mcp, the /.well-known/* OAuth
# metadata, /authorize (redirects to Google), /register, and /token. Create the
# OAuth client ONCE in the Google Cloud console (type "Web application") and add
# the MCP clients' redirect URIs to it, e.g.
# https://claude.ai/api/mcp/auth_callback (plus any other MCP client's
# callback). Then paste the credentials below. These are fake local values.
GOOGLE_CLIENT_ID=000000000000-fakeexamplelocalclientid.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-fake-local-client-secret
# Origin the brain serves its OAuth metadata, /authorize, /token, and /register
# on; it is the OAuth issuer advertised to MCP clients.
BRAIN_PUBLIC_URL=http://localhost:3010
# Google Workspace domain MCP access is restricted to (hd param on authorize +
# verified on the token's hosted-domain/email). Defaults to onfabric.io.
GOOGLE_WORKSPACE_DOMAIN=onfabric.io
