{
  "name": "company-brain-monorepo",
  "type": "module",
  "private": true,
  "bin": {
    "company-brain": "./cli/src/main.ts"
  },
  "scripts": {
    "company-brain": "bun cli/src/main.ts",
    "brain": "bun cli/src/main.ts",
    "setup:local": "bun run company-brain local setup",
    "doctor:local": "bun run company-brain local doctor",
    "setup:integrations": "bun run company-brain nango integrations",
    "setup:syncs": "bun run company-brain nango syncs",
    "deploy:syncs": "bun run company-brain nango syncs",
    "test": "bun run --filter '*' test",
    "check:types": "bun run --filter '*' check:types",
    "check:codestyle": "bun run --bun biome check",
    "check:all": "bun check:types && bun check:codestyle",
    "fix:codestyle": "bun run --bun biome check --write"
  },
  "workspaces": {
    "packages": [
      "agent-sync/",
      "cli/",
      "nango-integrations/",
      "backend/",
      "dashboard/"
    ],
    "catalog": {
      "typescript": "^5.9.3"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "1.3.14",
    "typescript": "catalog:"
  }
}
