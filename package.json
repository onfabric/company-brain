{
  "name": "company-brain-monorepo",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun run --filter '*' test",
    "check:types": "bun run --filter '*' check:types",
    "check:codestyle": "bun run --bun biome check",
    "check:all": "bun check:types && bun check:codestyle",
    "fix:codestyle": "bun run --bun biome check --write"
  },
  "workspaces": {
    "packages": [
      "agent-sync/",
      "nango-integrations/",
      "backend/",
      "dashboard/",
      "logto-setup/"
    ],
    "catalog": {
      "typescript": "^5.9.3"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "1.3.14",
    "typescript": "catalog:"
  }
}
